#include <iostream>
#include <sstream>
#include <vector>
#include <cctype>
using namespace std;


bool isKeyword(string word)
{
    return (word == "int" || word == "float" || word == "double" || word == "char");
}


bool isOperator(string op)
{
    return (op == "+" || op == "-" || op == "*" || op == "/" || op == "=");
}


bool isSymbol(char ch)
{
    return (ch == ';' || ch == '(' || ch == ')' || ch == '{' || ch == '}');
}


bool isNumber(string str)
{
    for (char ch : str)
    {
        if (!isdigit(ch))
            return false;
    }
    return true;
}

int main()
{
    string input = "This is a int sum = 10; and a + b = 20;";
    vector<string> tokens;

    string temp = "";

 
    for (int i = 0; i < input.length(); i++)
    {
        char ch = input[i];

        if (isspace(ch))
        {
            if (!temp.empty())
            {
                tokens.push_back(temp);
                temp = "";
            }
        }
        else if (isSymbol(ch) || ch == '+' || ch == '-' || ch == '*' || ch == '/' || ch == '=')
        {
            if (!temp.empty())
            {
                tokens.push_back(temp);
                temp = "";
            }
            tokens.push_back(string(1, ch));
        }
        else
        {
            temp += ch;
        }
    }

    if (!temp.empty())
        tokens.push_back(temp);

    
    cout << "Token\t\tType" << endl;
    cout << "-------------------------" << endl;

    for (string token : tokens)
    {
        if (isKeyword(token))
            cout << token << "\t\tKeyword" << endl;
        else if (isOperator(token))
            cout << token << "\t\tOperator" << endl;
        else if (token.length() == 1 && isSymbol(token[0]))
            cout << token << "\t\tSymbol" << endl;
        else if (isNumber(token))
            cout << token << "\t\tNumber" << endl;
        else
            cout << token << "\t\tIdentifier" << endl;
    }

    return 0;
}
